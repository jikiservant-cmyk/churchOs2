# churchOs — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# Gemini / AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY="" # Legacy fallback for the Edge apikey header
SUPABASE_PUBLISHABLE_KEY="" # Publishable key for server-to-Edge apikey header
SUPABASE_SERVICE_ROLE_KEY=""

# Dedicated secret for signing usher session JWTs — generate with: openssl rand -hex 32
USHER_JWT_SECRET="REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET"

# SMS Edge dispatch secret (same value as Supabase Edge secret DISPATCH_SECRET)
SMS_DISPATCH_SECRET="REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET"

# Queue worker endpoint secret (separate from SMS_DISPATCH_SECRET)
QUEUE_PROCESSOR_SECRET="REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET"

# ─────────────────────────────────────────────────────────────────────────────
# Na'jiki Finance — the only SMS and payment gateway used by this application
# Contract reference: NAJIKI_INTEGRATION.md
# ─────────────────────────────────────────────────────────────────────────────

# Required by the Next.js server for Na'jiki payment initiation. The SMS Edge
# Function also needs this key set separately as an Edge Function secret.
# Never expose it to browser code.
NAJIKI_API_KEY=""

# Optional. Defaults to https://najiki.netlify.app. Trailing slashes are stripped.
NAJIKI_API_URL="https://najiki.netlify.app"

# Must match the church application's code configured in Na'jiki. Defaults to
# the seeded application code, `church`.
NAJIKI_APPLICATION_CODE="church"

# There is intentionally no global tenant-code fallback: configure `tenants.code`
# or the church slug for each workspace to prevent cross-tenant payment routing.

# Optional payment type code overrides; Na'jiki auto-registers unknown codes per application.
# Must be a Na'jiki platform-fee code so the SMS-credit payment stays on the platform wallet.
NAJIKI_PAYMENT_TYPE_TOPUP="BUY_SMS"
# Ordinary tenant payment type; Na'jiki auto-registers it per application if absent.
NAJIKI_PAYMENT_TYPE_DONATION="donation"
# Must be a Na'jiki platform-fee code; this default is seeded for account activations.
NAJIKI_PAYMENT_TYPE_ACTIVATION="ACCOUNT_ACTIVATION"

# Optional dedicated webhook signing secret. If omitted, webhook verification
# uses NAJIKI_API_KEY (as Na'jiki does for older application records).
NAJIKI_WEBHOOK_SECRET=""

# Optional request timeout in milliseconds (default 15000).
NAJIKI_TIMEOUT_MS="15000"

# Register exactly one Na'jiki callback path in Na'jiki Setup:
#   /api/webhooks/najiki  (recommended; same handler as /api/najiki/webhook)
# Both SMS delivery updates and all payment settlements are accepted only by
# these Na'jiki-signature-verified endpoints.
