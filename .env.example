# churchOs — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# Gemini / AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Dedicated secret for signing usher session JWTs — generate with: openssl rand -hex 32
USHER_JWT_SECRET="REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET"

# Queue Processor Secret (for SMS queue batch worker and cron triggers)
QUEUE_PROCESSOR_SECRET="REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET"

# ─────────────────────────────────────────────────────────────────────────────
# Na'jiki Finance — payments & SMS gateway
# Contract reference: NAJIKI_INTEGRATION.md  (verified against
# github.com/jikiservant-cmyk/najiki-finance2 @ 1155fc3)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Partner API key for the church application, created in Na'jiki's
# Setup screen (it is shown once). Sent as `Authorization: Bearer <key>` on
# every request — that is the only auth scheme POST /api/payments accepts.
NAJIKI_API_KEY=""

# REQUIRED. Origin of the Na'jiki deployment. Trailing slashes are stripped.
# Defaults to https://najiki.netlify.app when unset.
NAJIKI_API_URL="https://najiki.netlify.app"

# REQUIRED (has a default). Must equal the `code` of the church application row
# in Na'jiki's `applications` table. Na'jiki seeds that as lowercase `church`.
# A mismatch is rejected: 403 "Application code mismatch" on /api/messaging/send,
# 401 on /api/payments (the key lookup is filtered on this value).
NAJIKI_APPLICATION_CODE="church"

# OPTIONAL. Tenant code within the church application. Na'jiki resolves the
# tenant as (applicationId, code) and answers 404 "Invalid or inactive tenant"
# when it does not exist. churchOs normally sends the church's own
# `public.tenants.code` (falling back to the church slug), so this is only a
# last-resort default for churches that have neither.
# NAJIKI_TENANT_CODE="grace-church"

# OPTIONAL. `paymentTypeCode` sent for admin SMS-wallet top-ups and for public
# donations. Na'jiki resolves these against `payment_types` scoped to the church
# application; the seeded church application only has `tithe` and `offering`, so
# either create `topup` / `donation` rows in Na'jiki Setup or point these at
# codes that already exist. An unknown code is not rejected — the payment is
# simply stored with no payment type.
NAJIKI_PAYMENT_TYPE_TOPUP="topup"
NAJIKI_PAYMENT_TYPE_DONATION="donation"

# OPTIONAL. Secret Na'jiki signs outbound webhooks with (the application's
# `webhookSecret`, a separate credential from the API key). Falls back to
# NAJIKI_API_KEY, which is what Na'jiki signs with for applications provisioned
# before that column existed.
NAJIKI_WEBHOOK_SECRET=""

# OPTIONAL. Per-request timeout in ms (default 15000).
NAJIKI_TIMEOUT_MS="15000"

# The webhook path registered against the church application in Na'jiki Setup
# must be one of these two (they run the same handler):
#   /api/webhooks/najiki      ← recommended
#   /api/najiki/webhook
# Na'jiki POSTs to `${application.baseUrl}${application.webhookPath}` and signs
# with X-Najiki-Timestamp + X-Najiki-Signature. See NAJIKI_INTEGRATION.md.

# LivePay API Credentials (direct-to-provider path, used when configured; the
# Na'jiki path above is the fallback for donations)
LIVEPAY_API_KEY=""
LIVEPAY_ACCOUNT_NO=""
LIVEPAY_WEBHOOK_SECRET=""
WEBHOOK_SECRET=""
